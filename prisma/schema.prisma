// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Property {
  id           String   @id @default(cuid())
  title        String
  description  String
  price        Int      // in juta (millions IDR)
  location     String
  city         String
  type         String   // Rumah, Apartemen, Tanah, Ruko
  bedrooms     Int?
  bathrooms    Int?
  landArea     Int?     // in m2
  buildingArea Int?    // in m2
  image        String
  featured     Boolean  @default(false)
  status       String   @default("active") // active, sold, reserved
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  leads        Lead[]

  @@map("properties")
}

model Lead {
  id           String    @id @default(cuid())
  name         String
  whatsapp     String
  propertyType String?   @map("property_type") // Jenis Properti: Rumah, Apartemen, Tanah, Ruko
  location     String?   // Lokasi yang dicari
  dp           String?   // DP / Uang Muka
  promo        String?   // Kode promo / Promo yang diminta
  propertyId   String?   @map("property_id")
  property     Property? @relation(fields: [propertyId], references: [id])
  message      String?
  status       String    @default("new") // new, contacted, qualified, closed
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("leads")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  whatsapp  String
  role      String   @default("agent") // admin, agent
  avatar    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model SeoSetting {
  id                 String   @id @default("main")
  siteName           String   @default("PropMart") @map("site_name")
  title              String   @default("PropMart - Temukan Properti Impian Anda")
  description        String   @default("Jual beli properti terpercaya di seluruh Indonesia. Rumah, apartemen, tanah, dan ruko dengan harga terbaik.")
  keywords           String   @default("properti, jual beli rumah, apartemen, tanah, ruko, Indonesia, real estate, KPR")
  ogImage            String   @default("/properties/hero-banner.png") @map("og_image")
  canonicalUrl       String   @default("") @map("canonical_url")
  robots             String   @default("index, follow")
  googleVerification String   @default("") @map("google_verification")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("seo_settings")
}
